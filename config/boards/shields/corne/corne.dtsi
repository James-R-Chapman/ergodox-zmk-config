#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &default_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
// | SW00 | SW01 | SW02 | SW03 | SW04 | SW05 | SW06 |   | SW07 | SW08 | SW09 | SW10 | SW11 | SW12 | SW13 |
// | SW14 | SW15 | SW16 | SW17 | SW18 | SW19 | SW20 |   | SW21 | SW22 | SW23 | SW24 | SW25 | SW26 | SW27 |
// | SW28 | SW29 | SW30 | SW31 | SW32 | SW33 | SW34 |   | SW35 | SW36 | SW37 | SW38 | SW39 | SW40 | SW41 |
// | SW42 | SW43 | SW44 | SW45 | SW46 | SW47 | SW48 |   | SW49 | SW50 | SW51 | SW52 | SW53 | SW54 | SW55 |
// | SW56 | SW57 | SW58 | SW59 | SW60 | SW61 | SW62 |   | SW63 | SW64 | SW65 | SW66 | SW67 | SW68 | SW69 |
            map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
            >;
    };
 
    kscan0: kscan_0 {
        diode-direction = "col2row";
    };

    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "REDOX";

        transform = <&default_transform>;

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0  105       0     0     0>
            , <&key_physical_attrs 100 100  100  105       0     0     0>
            , <&key_physical_attrs 100 100  200   35       0     0     0>
            , <&key_physical_attrs 100 100  300    0       0     0     0>
            , <&key_physical_attrs 100 100  400   30       0     0     0>
            , <&key_physical_attrs 100 100  500   45       0     0     0>
            , <&key_physical_attrs 100 100  600   65       0     0     0>
            , <&key_physical_attrs 100 100  900   65       0     0     0>
            , <&key_physical_attrs 100 100 1000   45       0     0     0>
            , <&key_physical_attrs 100 100 1100   30       0     0     0>
            , <&key_physical_attrs 100 100 1200    0       0     0     0>
            , <&key_physical_attrs 100 100 1300   35       0     0     0>
            , <&key_physical_attrs 100 100 1400  105       0     0     0>
            , <&key_physical_attrs 100 100 1500  105       0     0     0>
            , <&key_physical_attrs 100 100    0  205       0     0     0>
            , <&key_physical_attrs 100 100  100  205       0     0     0>
            , <&key_physical_attrs 100 100  200  135       0     0     0>
            , <&key_physical_attrs 100 100  300  100       0     0     0>
            , <&key_physical_attrs 100 100  400  130       0     0     0>
            , <&key_physical_attrs 100 100  500  145       0     0     0>
            , <&key_physical_attrs 100 100  600  165       0     0     0>
            , <&key_physical_attrs 100 100  900  165       0     0     0>
            , <&key_physical_attrs 100 100 1000  145       0     0     0>
            , <&key_physical_attrs 100 100 1100  130       0     0     0>
            , <&key_physical_attrs 100 100 1200  100       0     0     0>
            , <&key_physical_attrs 100 100 1300  135       0     0     0>
            , <&key_physical_attrs 100 100 1400  205       0     0     0>
            , <&key_physical_attrs 100 100 1500  205       0     0     0>
            , <&key_physical_attrs 100 100    0  305       0     0     0>
            , <&key_physical_attrs 100 100  100  305       0     0     0>
            , <&key_physical_attrs 100 100  200  235       0     0     0>
            , <&key_physical_attrs 100 100  300  200       0     0     0>
