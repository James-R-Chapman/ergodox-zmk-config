            , <&key_physical_attrs 100 100  500  245       0     0     0>
            , <&key_physical_attrs 100 100  600  265       0     0     0>
            , <&key_physical_attrs 100 100  900  265       0     0     0>
            , <&key_physical_attrs 100 100 1000  245       0     0     0>
            , <&key_physical_attrs 100 100 1100  230       0     0     0>
            , <&key_physical_attrs 100 100 1200  200       0     0     0>
            , <&key_physical_attrs 100 100 1300  235       0     0     0>
            , <&key_physical_attrs 100 100 1400  305       0     0     0>
            , <&key_physical_attrs 100 100 1500  305       0     0     0>
            , <&key_physical_attrs 100 100    0  405       0     0     0>
            , <&key_physical_attrs 100 100  100  405       0     0     0>
            , <&key_physical_attrs 100 100  200  335       0     0     0>
            , <&key_physical_attrs 100 100  300  300       0     0     0>
            , <&key_physical_attrs 100 100  400  330       0     0     0>
            , <&key_physical_attrs 100 100  500  345       0     0     0>
            , <&key_physical_attrs 100 100  600  365       0     0     0>
            , <&key_physical_attrs 100 100  900  365       0     0     0>
            , <&key_physical_attrs 100 100 1000  345       0     0     0>
            , <&key_physical_attrs 100 100 1100  330       0     0     0>
            , <&key_physical_attrs 100 100 1200  300       0     0     0>
            , <&key_physical_attrs 100 100 1300  335       0     0     0>
            , <&key_physical_attrs 100 100 1400  405       0     0     0>
            , <&key_physical_attrs 100 100 1500  405       0     0     0>
            , <&key_physical_attrs 100 100    0  505       0     0     0>
            , <&key_physical_attrs 100 100  100  505       0     0     0>
            , <&key_physical_attrs 100 100  200  435       0     0     0>
            , <&key_physical_attrs 100 100  300  400       0     0     0>
            , <&key_physical_attrs 100 100  400  430       0     0     0>
            , <&key_physical_attrs 100 100  500  445       0     0     0>
            , <&key_physical_attrs 100 100  600  465       0     0     0>
