#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            display-name = "Base";
            bindings = <
                /* row 0 */
                &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL  &kp BSPC
                /* row 1 */
                &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT   &kp BSLH
                /* row 2 */
                &kp CAPSLOCK &kp A  &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp ENTER  &kp DEL
                /* row 3 */
                &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp UP    &kp PG_UP  &kp HOME
                /* row 4 */
                &kp LCTRL &kp LGUI  &kp LALT  &kp SPACE &none     &none     &none     &none     &kp ENTER &kp RALT  &kp RCTRL &kp LEFT  &kp DOWN   &kp RIGHT
            >;
        };

        Lower {
            label = "Lower";
            display-name = "Lower";
            bindings = <
                /* row 0 */
                &kp GRAVE &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL  &kp BSPC
                /* row 1 */
                &kp TAB   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans     &trans    &trans
                /* row 2 */
                &kp CAPSLOCK &trans &trans   &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans     &trans
                /* row 3 */
                &kp LSHFT &trans    &trans   &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp PG_UP &kp PG_DN  &kp END
                /* row 4 */
                &kp LCTRL &kp LGUI  &kp LALT &kp SPACE &none     &none     &none     &none     &kp ENTER &kp RALT  &kp RCTRL &kp HOME  &kp PG_DN  &kp END
            >;
        };

        Upper {
            label = "Upper";
            display-name = "Upper";
            bindings = <
                /* row 0 */
                &kp TILDE &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT &kp CARET &kp AMPS  &kp ASTERISK &kp LPAR &kp RPAR  &kp UNDER &kp PLUS   &kp BSPC
                /* row 1 */
                &kp TAB   &trans    &trans    &trans    &trans    &trans    &kp MINUS &kp EQUAL &kp LBKT    &kp RBKT &kp BSLH  &kp LBRC  &kp RBRC   &kp PIPE
                /* row 2 */
                &kp CAPSLOCK &trans &trans    &trans    &trans    &trans    &trans    &trans    &trans      &trans   &trans    &trans    &kp ENTER  &kp DEL
                /* row 3 */
                &kp LSHFT &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans      &trans   &trans    &kp PG_UP &kp PG_DN &kp END
                /* row 4 */
                &kp LCTRL &kp LGUI  &kp LALT  &kp SPACE &none     &none     &none     &none     &kp ENTER   &kp RALT &kp RCTRL &kp HOME  &kp PG_DN  &kp END
            >;
        };
    };
};
